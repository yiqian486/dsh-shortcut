<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="wizardWindow"
        Title="DSH 启动器"
        Width="640" Height="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <!--
    宽松 XAML：没有 x:Class、没有 code-behind，所以**不能**写 Click="..." 这类事件属性
    —— XamlReader.Load 会直接报错。所有事件都在 setup-gui.ps1 里用 Add_Click 挂。

    自检列表里每一行也不是 DataTemplate + ItemsControl：那样要在容器生成后遍历视觉树
    才能挂上「安装」按钮的事件，而容器只有布局后才存在，没法在不开窗的情况下验证。
    这里改为在 PowerShell 里直接构造行元素，行为可测。
  -->

  <Window.Resources>
    <SolidColorBrush x:Key="BgBrush"      Color="#1F1F23"/>
    <SolidColorBrush x:Key="CardBrush"    Color="#2A2A31"/>
    <SolidColorBrush x:Key="LineBrush"    Color="#33333B"/>
    <SolidColorBrush x:Key="FgBrush"      Color="#E9E9EE"/>
    <SolidColorBrush x:Key="DimBrush"     Color="#9A9AA6"/>
    <SolidColorBrush x:Key="AccentBrush"  Color="#35C6A5"/>
    <SolidColorBrush x:Key="AccentDark"   Color="#2AA98C"/>
    <SolidColorBrush x:Key="OkBrush"      Color="#4CAF50"/>
    <SolidColorBrush x:Key="WarnBrush"    Color="#E6A23C"/>
    <SolidColorBrush x:Key="FailBrush"    Color="#E5484D"/>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="FieldBox" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource CardBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="CaretBrush" Value="{StaticResource FgBrush}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- 主按钮：圆角 + 主题色 -->
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="#0E1A17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="18,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="6" Background="{StaticResource AccentBrush}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentDark}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 次要按钮：描边 -->
    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="6" Background="Transparent"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource CardBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 关窗按钮 -->
    <Style x:Key="CloseButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#E5484D"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="borderRoot" CornerRadius="10" Background="{StaticResource BgBrush}"
          BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- ===== 自绘标题栏（拖动由 setup-gui.ps1 的 DragMove 处理） ===== -->
      <Grid x:Name="titleBar" Grid.Row="0" Height="46" Background="Transparent">
        <TextBlock Text="DSH 启动器" Margin="18,0,0,0" VerticalAlignment="Center"
                   FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}"/>
        <TextBlock x:Name="tbRepoSource" HorizontalAlignment="Right" VerticalAlignment="Center"
                   Margin="0,0,56,0" FontSize="11.5" Foreground="{StaticResource DimBrush}"/>
        <Button x:Name="btnClose" Content="✕" HorizontalAlignment="Right"
                Style="{StaticResource CloseButton}"/>
      </Grid>

      <!-- ===== 主体 ===== -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,0,18,0">
        <StackPanel>

          <TextBlock Style="{StaticResource SectionTitle}" Text="dsh 检出目录"/>
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="tbRepo" Style="{StaticResource FieldBox}"/>
            <Button x:Name="btnBrowse" Grid.Column="1" Content="浏览…"
                    Margin="8,0,0,0" Style="{StaticResource GhostButton}"/>
            <Button x:Name="btnFetch" Grid.Column="2" Content="获取 dsh"
                    Margin="8,0,0,0" Style="{StaticResource GhostButton}"/>
          </Grid>
          <TextBlock x:Name="tbRepoHint" Style="{StaticResource Hint}" Margin="0,6,0,0"
                     Text="指向 deepseek-harness 源码检出的根目录（含 apps\cli）。"/>

          <!-- 前置依赖单独成块：它说的是「这台机器上有没有」，跟检出自身的状态不是一回事 -->
          <Grid Margin="0,20,0,0">
            <TextBlock Style="{StaticResource SectionTitle}" Text="前置依赖"/>
            <TextBlock x:Name="tbDepsSummary" HorizontalAlignment="Right" VerticalAlignment="Center"
                       FontSize="11.5" Foreground="{StaticResource DimBrush}"/>
          </Grid>
          <StackPanel x:Name="pnlDeps" Margin="0,8,0,0"/>

          <TextBlock Style="{StaticResource SectionTitle}" Text="环境自检" Margin="0,20,0,0"/>
          <StackPanel x:Name="pnlChecks" Margin="0,8,0,0"/>

          <TextBlock Style="{StaticResource SectionTitle}" Text="启动选项" Margin="0,20,0,0"/>
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="90"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="端口" VerticalAlignment="Center" Foreground="{StaticResource FgBrush}"/>
            <TextBox x:Name="tbPort" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource FieldBox}"/>
            <TextBlock Grid.Column="2" Text="快捷方式名字" Margin="18,0,0,0"
                       VerticalAlignment="Center" Foreground="{StaticResource FgBrush}"/>
            <TextBox x:Name="tbName" Grid.Column="3" Margin="8,0,0,0" Style="{StaticResource FieldBox}"/>
          </Grid>

          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <CheckBox x:Name="cbDesktop" Content="创建桌面快捷方式" IsChecked="True"
                      Foreground="{StaticResource FgBrush}"/>
            <CheckBox x:Name="cbStartMenu" Content="创建开始菜单快捷方式" Margin="20,0,0,0"
                      Foreground="{StaticResource FgBrush}"/>
          </StackPanel>

          <!-- ===== 日志区（方案 B 的 clone / pnpm install 输出进这里） ===== -->
          <TextBlock x:Name="tbLogTitle" Style="{StaticResource SectionTitle}" Text="日志"
                     Margin="0,20,0,0" Visibility="Collapsed"/>
          <ProgressBar x:Name="pbProgress" Height="4" Margin="0,8,0,0" Visibility="Collapsed"
                       Foreground="{StaticResource AccentBrush}" Background="{StaticResource CardBrush}"
                       BorderThickness="0"/>
          <TextBox x:Name="tbLog" Margin="0,8,0,0" Height="140" Visibility="Collapsed"
                   Style="{StaticResource FieldBox}" IsReadOnly="True"
                   FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5"
                   VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                   AcceptsReturn="True"/>
        </StackPanel>
      </ScrollViewer>

      <!-- ===== 底栏 ===== -->
      <Grid Grid.Row="2" Margin="18,14,18,16">
        <TextBlock x:Name="tbSummary" VerticalAlignment="Center"
                   Foreground="{StaticResource DimBrush}" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="btnRecheck" Content="重新检测" Style="{StaticResource GhostButton}"/>
          <Button x:Name="btnInstall" Content="安装" Margin="8,0,0,0"
                  Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
